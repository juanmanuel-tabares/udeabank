# URL base de la API.
# Por defecto se usa "/api", que el dev server de Vite reenvia al backend
# (ver VITE_API_PROXY_TARGET). Asi no hace falta CORS en desarrollo.
VITE_API_BASE_URL=/api

# Destino del proxy del dev server. Solo aplica con `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080

# Para apuntar a un backend remoto sin proxy, usa la URL absoluta y
# asegurate de que el origen del frontend este permitido en CorsConfig.java:
# VITE_API_BASE_URL=http://localhost:8080/api
